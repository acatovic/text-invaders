{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "txt-invaders",
  "account_id": "9137679816f098fde321fdf7914bdf1b",
  "main": "worker.js",
  "compatibility_date": "2026-10-22",
  "routes": [
    { "pattern": "txtinvaders.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "txt-invaders",
      "database_id": "08f9b078-aa2f-40c1-98bb-5300aea6f627",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "WRITE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "observability": { "enabled": false }
}
